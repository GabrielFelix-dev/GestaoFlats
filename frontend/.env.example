# URL base da API consumida pelo front-end.
#
# Em desenvolvimento o valor padrão "/api" é suficiente: o Vite faz proxy
# desse caminho para http://localhost:3333 (veja vite.config.js).
#
# Na publicação, com a API em outro domínio, informe a URL completa,
# por exemplo: VITE_API_URL=https://gestaoflats-api.vercel.app/api
#
# variáveis do Vite só são lidas em arquivos com o prefixo VITE_.
VITE_API_URL=/api
