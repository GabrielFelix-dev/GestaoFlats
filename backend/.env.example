# Servidor
PORT=3333
NODE_ENV=development

# MongoDB
# Local:   mongodb://127.0.0.1:27017/gestaoflats
# Atlas:   mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/gestaoflats
MONGODB_URI=mongodb://127.0.0.1:27017/gestaoflats

# Autenticação (troque os valores em producao)
JWT_SECRET=troque-este-valor-em-producao
JWT_EXPIRES_IN=1d

# CORS: origem permitida do front-end
CLIENT_URL=http://localhost:5173